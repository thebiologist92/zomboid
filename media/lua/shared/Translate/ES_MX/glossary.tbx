<martif type="TBX" xml:lang="en">
    <martifHeader>
        <fileDesc>
            <sourceDesc>
                <p>Weblate Glossary</p>
            </sourceDesc>
        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry>
                <langSet xml:lang="en"><tig><term>workstation</term></tig></langSet>
                <langSet xml:lang="ES_MX"><tig><term/></tig></langSet>
            </termEntry>
            <termEntry id="Cáñamo">
                <langSet xml:lang="en"><tig><term>Burlap</term></tig></langSet>
                <langSet xml:lang="ES_MX"><tig><term>Cáñamo</term></tig></langSet>
                <note from="translator">Commonly known as "Arpillera" in Spanish, it is a handmade fabric. In México, the best way to use it in MX is "Cáñamo" since nobody knows it as "Arpillera". Cáñamo is  a local material which can be found in many parts of the country</note>
            </termEntry>
        </body>
    </text>
</martif>
